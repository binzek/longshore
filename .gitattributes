# Normalise line endings to LF so Windows checkouts, Prettier and CI agree.
* text=auto eol=lf

# Binary assets (models, audio, fonts, images) must never be rewritten.
*.glb binary
*.gltf text
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.woff binary
*.woff2 binary
*.ttf binary
